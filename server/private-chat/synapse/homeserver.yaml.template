# Generated by ZeroVPN. Secrets are injected into a private systemd runtime file.
server_name: "__SERVER_NAME__"
public_baseurl: "https://__WIREGUARD_ADDRESS__/"
pid_file: "/run/zerovpn-private-chat-synapse/homeserver.pid"

listeners:
  - port: 8008
    tls: false
    type: http
    bind_addresses:
      - 127.0.0.1
    x_forwarded: true
    resources:
      - names:
          - client
        compress: false

database:
  name: psycopg2
  args:
    host: 127.0.0.1
    port: 5432
    user: zerovpn_synapse
    password: "__POSTGRES_PASSWORD__"
    database: zerovpn_synapse
    cp_min: 2
    cp_max: 5

log_config: "/etc/zerovpn/private-chat/synapse/log.config"
media_store_path: "/var/lib/zerovpn/private-chat/synapse/media_store"
signing_key_path: "/var/lib/zerovpn/private-chat/synapse/signing.key"
registration_shared_secret_path: "/run/credentials/zerovpn-private-chat-synapse.service/registration_shared_secret"

enable_registration: false
enable_registration_without_verification: false
allow_guest_access: false
allow_public_rooms_without_auth: false
allow_public_rooms_over_federation: false
federation_domain_whitelist: []
send_federation: false
trusted_key_servers: []
suppress_key_server_warning: true
url_preview_enabled: false
enable_3pid_lookup: false
enable_media_repo: false
enable_metrics: false
report_stats: false

presence:
  enabled: false

retention:
  enabled: true
  default_policy:
    max_lifetime: 30d
  allowed_lifetime_min: 1d
  allowed_lifetime_max: 30d
  purge_jobs:
    - shortest_max_lifetime: 1d
      longest_max_lifetime: 30d
      interval: 1d
