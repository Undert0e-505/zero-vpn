# Generated by ZeroVPN. This listener is bound only to the WireGuard address.
server {
    listen __WIREGUARD_ADDRESS__:443 ssl;
    server_name __SERVER_NAME__ __WIREGUARD_ADDRESS__;
    server_tokens off;

    ssl_certificate /etc/zerovpn/private-chat/tls/node.crt;
    ssl_certificate_key /etc/zerovpn/private-chat/tls/node.key;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_tickets off;
    access_log off;

    location = /.well-known/matrix/client {
        default_type application/json;
        return 200 '{"m.homeserver":{"base_url":"https://__WIREGUARD_ADDRESS__/"}}';
    }

    # Administration and federation remain available only on Synapse's loopback listener.
    location = /_synapse/admin { return 404; }
    location ^~ /_synapse/admin/ { return 404; }
    location = /_matrix/federation { return 404; }
    location ^~ /_matrix/federation/ { return 404; }
    location = /_matrix/key { return 404; }
    location ^~ /_matrix/key/ { return 404; }

    location /_matrix/ {
        proxy_pass http://127.0.0.1:8008;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto https;
        proxy_read_timeout 120s;
        client_max_body_size 64k;
    }
}
