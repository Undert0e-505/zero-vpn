[Unit]
Description=ZeroVPN private Matrix homeserver
After=network-online.target postgresql.service wg-quick@wg0.service
Wants=network-online.target
Requires=postgresql.service wg-quick@wg0.service

[Service]
Type=simple
User=zerovpn-synapse
Group=zerovpn-synapse
UMask=0077
WorkingDirectory=/var/lib/zerovpn/private-chat/synapse
RuntimeDirectory=zerovpn-private-chat-synapse
RuntimeDirectoryMode=0700
LoadCredential=postgres_password:/etc/zerovpn/private-chat/secrets/postgres_password
LoadCredential=registration_shared_secret:/etc/zerovpn/private-chat/secrets/registration_shared_secret
ExecStartPre=/opt/zerovpn/private-chat/synapse/render-runtime-config.py
ExecStart=/opt/zerovpn/private-chat/venv/synapse/bin/python -m synapse.app.homeserver --config-path /run/zerovpn-private-chat-synapse/homeserver.yaml
Restart=on-failure
RestartSec=5s
TimeoutStartSec=180s
NoNewPrivileges=true
PrivateDevices=true
PrivateTmp=true
ProtectControlGroups=true
ProtectHome=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectSystem=strict
ReadWritePaths=/var/lib/zerovpn/private-chat/synapse
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictRealtime=true
LockPersonality=true
SystemCallArchitectures=native
IPAddressDeny=any
IPAddressAllow=localhost

[Install]
WantedBy=multi-user.target

